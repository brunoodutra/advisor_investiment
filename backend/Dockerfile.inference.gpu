FROM tensorflow/tensorflow:2.12.0-gpu

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY backend/AI/Classification/requirements.gpu.txt /tmp/requirements.gpu.txt

RUN python -m pip install --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.gpu.txt

COPY backend /app/backend

ENV PYTHONPATH=/app/backend
WORKDIR /app/backend

CMD ["python", "-u", "AI/Classification/Real_Time_Inference/classification_in_produtction.py"]
